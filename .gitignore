# Node modules (installed via npm)
node_modules/

# Build output
dist/
build/

# User data (data folder should exist, but ignore its contents)
data/*
!data/

# Personal dev files
Vision of the App.txt

# OS / editor junk
.DS_Store
Thumbs.db

# Environment or secret config files (if any)
.env
.env.local

# Electron build caches (optional but helpful)
out/
.cache/

# Log files
*.log
*.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
